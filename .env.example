# Required for Supabase browser + SSR auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Recommended for email confirmation and password recovery links.
# If omitted, browser auth actions fall back to the current window origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional hosting-level fallback if your platform injects a canonical site URL:
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Legacy fallback key name still supported by the codebase if needed:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key

# Server-only: required for `npm run seed:curriculum` (never expose in the browser)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only: optional, enables the grounded "AI Overview-like" research panel.
# Create a Gemini API key in Google AI Studio and keep it server-side only.
# GEMINI_API_KEY=your-gemini-api-key
# Optional structured local-coach model override for the topic assistant.
# The default in code is `gemini-2.5-flash`.
# GEMINI_COACH_MODEL=gemini-2.5-flash
# Optional grounded model override. The default in code is `gemini-2.5-flash`.
# GEMINI_GROUNDED_MODEL=gemini-2.5-flash
