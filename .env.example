# Copy this file to `.env.local` (gitignored) and fill in values. Then: `npm install` && `npm run dev`
# In Supabase: Authentication → URL configuration → add redirect URLs:
#   http://localhost:3000/auth/callback
#   http://localhost:3000/**
#
# Required for Supabase browser + SSR auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Use your dev server origin so email / magic links work when testing locally.
# If omitted, some in-app redirects still work via window.location, but emailed links may not.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional hosting-level fallback if your platform injects a canonical site URL:
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Block search engines (robots.txt Disallow: / + X-Robots-Tag: noindex, nofollow on all routes).
# Set to 1 on staging / private deploys. Omit or set to 0 for a public launch. Netlify: auto-set for Deploy Previews via netlify.toml.
# BLOCK_SEARCH_INDEXING=1

# --- Security / hosting (production) — “triple”: HTTPS + Cloudflare + optional gate ---
# Step-by-step: docs/production-triple-security.md
#
# HTTPS: terminate TLS at your host (e.g. Vercel) or use Cloudflare proxy with SSL/TLS "Full (strict)" to origin.
# This app redirects HTTP→HTTPS in production when `x-forwarded-proto` is `http`.
# WAF / bot mitigation: enable in Cloudflare (or your CDN); not configured in this repo.
# HSTS: automatic on Vercel (VERCEL=1) or Netlify (NETLIFY=true at build). Else ENABLE_HSTS=1 only after TLS is correct.

# Optional whole-site access gate (shared password, httpOnly cookie). Omit to leave the site open.
# SITE_GATE_PASSWORD=your-shared-preview-password
# SITE_GATE_SECRET=long-random-secret

# Legacy fallback key name still supported by the codebase if needed:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key

# Server-only: required for `npm run seed:curriculum` (never expose in the browser)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only: optional, enables the grounded "AI Overview-like" research panel.
# Create a Gemini API key in Google AI Studio and keep it server-side only.
# GEMINI_API_KEY=your-gemini-api-key
# Optional structured local-coach model override for the topic assistant.
# The default in code is `gemini-2.5-flash`.
# GEMINI_COACH_MODEL=gemini-2.5-flash
# Optional grounded model override. The default in code is `gemini-2.5-flash`.
# GEMINI_GROUNDED_MODEL=gemini-2.5-flash
